<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.daraz.pipeline</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>/Users/suren/Projects/product-market-analyzer/pipeline.sh</string></array>
