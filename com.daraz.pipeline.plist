  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StandardOutPath</key><string>/Users/suren/Projects/product-market-analyzer/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/suren/Projects/product-market-analyzer/logs/launchd.log</string>
</dict>
</plist>
