# Required for every crawl: none | liveproxies | decodo | mrscraper (set per command, e.g. PROXY=liveproxies)
MRSCRAPER_TOKEN=your_token_here
MRSCRAPER_PROXY_COUNTRY=np
# liveproxies: host/port/user only. USER = account id + access code (no session suffix;
# the crawler appends -1..-N). Password lives in Keychain:
#   security add-generic-password -U -s liveproxies-proxy -a $USER -w
LIVEPROXIES_HOST=b2b.liveproxies.io
LIVEPROXIES_PORT=7383
LIVEPROXIES_USER=LVxxxxxxxx-lv_in
LIVEPROXIES_SESSIONS=200
# decodo: datacenter pool, one exit IP per port. Password in Keychain:
#   security add-generic-password -U -s decodo-proxy -a $USER -w
DECODO_HOST=dc.decodo.com
DECODO_USER=
DECODO_PORT_BASE=10001
DECODO_PORTS=100
